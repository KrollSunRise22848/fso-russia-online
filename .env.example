# ============================================================
# ФСО — Россия Онлайн: Переменные окружения
# Скопируйте этот файл в .env (для локалки) или настройте в Vercel
# ============================================================

# === БАЗА ДАННЫХ ===

# Для локальной разработки (SQLite):
DATABASE_URL="file:./db/custom.db"

# Для продакшена на Vercel (Neon PostgreSQL):
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# === СЕКРЕТ ДЛЯ ПОДПИСИ COOKIE АДМИНА ===
# Длинная случайная строка (минимум 32 символа). Сгенерировать: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-long-random-string-in-production-please"

# === NEXT.js (автоматически на Vercel) ===
# NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"
